generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole { CUSTOMER ADMIN }
enum OrderStatus { PENDING_PAYMENT PAYMENT_SUCCESSFUL ORDER_RECEIVED ACCEPTED PROCESSING READY_FOR_PICKUP COLLECTED CANCELLED REFUND_PENDING REFUNDED }
enum PaymentStatus { PENDING SUCCESS FAILED REFUNDED }
enum ItemType { SERVICE PRODUCT }

model User {
  id           String   @id @default(cuid())
  name         String?
  phone        String   @unique
  role         UserRole @default(CUSTOMER)
  isVerified   Boolean  @default(false)
  otpHash      String?
  otpExpiresAt DateTime?
  createdAt    DateTime @default(now())
  orders       Order[]
}
model Category {
  id       String    @id @default(cuid())
  name     String
  nameMr   String?
  slug     String    @unique
  products Product[]
  services Service[]
}
model Service {
  id          String     @id @default(cuid())
  name        String
  nameMr      String?
  description String
  price       Float
  active      Boolean    @default(true)
  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
}
model Product {
  id          String     @id @default(cuid())
  name        String
  nameMr      String?
  description String
  imageUrl    String?
  price       Float
  stock       Int        @default(0)
  available   Boolean    @default(true)
  categoryId  String?
  category    Category?  @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
}
model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique
  customerId     String
  customer       User          @relation(fields: [customerId], references: [id])
  status         OrderStatus   @default(PENDING_PAYMENT)
  paymentStatus  PaymentStatus @default(PENDING)
  total          Float
  notes          String?
  pickupOtpHash  String?
  pickupOtpExpiresAt DateTime?
  pickupOtpAttempts Int       @default(0)
  collectedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  items          OrderItem[]
  payments       Payment[]
}
model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  itemType  ItemType
  quantity  Int
  unitPrice Float
  lineTotal Float
  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])
  productId String?
  product  Product?  @relation(fields: [productId], references: [id])
}
model Payment {
  id            String        @id @default(cuid())
  orderId       String
  order         Order         @relation(fields: [orderId], references: [id])
  provider      String
  method        String
  status        PaymentStatus @default(PENDING)
  amount        Float
  transactionId String?       @unique
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
}
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
